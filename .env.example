# Frontend (public — these values end up in the browser bundle; never put secrets here)
# URL of the deployed Cloudflare Worker. Leave empty in dev (Vite proxies /api to wrangler dev).
VITE_API_BASE_URL=

# Backend secret — DO NOT put it in this file. Put it in `.dev.vars` (local, git-ignored):
#   GEMINI_API_KEY=your-key-here
# and for the deployed worker run:  npx wrangler secret put GEMINI_API_KEY
